{
  "name": "ironwild",
  "version": "0.1.0",
  "description": "IRONWILD - an original open-world machine-hunting prototype (browser, Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
