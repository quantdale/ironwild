    "three": "^0.166.0",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "vitest": "^4.1.11"
  }
}
